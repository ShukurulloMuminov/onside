# Copy to .env at the repo root before running docker compose -f docker-compose.prod.yml.
# Read by docker-compose.prod.yml itself (not by the Django/Next.js apps directly).

POSTGRES_DB=onside
POSTGRES_USER=onside
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Public site URL (used for Caddy's TLS cert + the frontend's absolute
# media/admin links). Both point at the same domain — Caddy path-routes
# /api, /admin, /static, /media to the backend and everything else to the
# frontend, so there's no separate api. subdomain to configure.
PUBLIC_ORIGIN=https://onside.uz
PUBLIC_ORIGIN_HOST=onside.uz

# Optional — leave blank to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
